{
  "train_micro_batch_size_per_gpu": 1,
  "gradient_accumulation_steps": 1,
  "gradient_clipping": 1.0,
  "torch_autocast": {
    "enabled": true,
    "dtype": "bfloat16"
  },
  "zero_optimization": {
    "stage": 1
  },
  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 2.5e-4,
      "betas": [0.9, 0.98],
      "eps": 1e-12,
      "weight_decay": 1.0e-2,
      "adam_w_mode": true,
      "torch_adam": true
    }
  },
  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_type": "linear",
      "total_num_steps": 800000,
      "warmup_num_steps": 40000,
      "warmup_max_lr": 2.5e-4,
      "warmup_min_lr": 1.0e-6
    }
  },
  "wall_clock_breakdown": false,
  "steps_per_print": 3000,
  "tensorboard": {
    "enabled": false,
    "output_path": "exp/openbeats_large/tb",
    "job_name": "openbeats_large"
  },
  "wandb": {
    "enabled": false,
    "project": "openbeats",
    "group": "openbeats_large"
  }
}
